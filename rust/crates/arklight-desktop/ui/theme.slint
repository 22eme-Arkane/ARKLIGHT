// Thème et éléments de base de l'interface, repris de la version JavaScript (web/css/app.css :
// variables de :root, boutons, pastilles d'état, barres d'outils). Icônes : ui/icons/*.svg,
// exportées de web/js/ui/icons.js (node tools/rust/export-icons.mjs), teintées ici.

export global Theme {
    out property <color> bg: #0c0e11;
    out property <color> panel: #14171c;
    out property <color> panel-2: #1a1e24;
    out property <color> line: #262b33;
    out property <color> line-2: #323844;
    out property <color> text: #d9dde3;
    out property <color> muted: #8a919c;
    out property <color> dim: #5d6470;
    out property <color> accent: #ffad3b;
    out property <color> accent-ink: #1b1204;
    out property <color> ok: #3ddc84;
    out property <color> warn: #ffcc4d;
    out property <color> err: #ff5d5d;
    out property <color> sel: #2d6cdf;
    out property <color> field: #0f1216;
    out property <color> hover: #20252c;
    out property <color> active: #2a3242;
    out property <color> active-line: #4a6aa8;
    out property <length> radius: 6px;
    out property <length> font: 13px;
    out property <length> small: 12px;
    out property <length> tiny: 11px;
    out property <string> mono: "Consolas";
}

/// Bulle d'aide des boutons (affichée par la fenêtre, au-dessus de tout).
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> visible;
}

/// Icône des barres d'outils (traits fins), à la couleur voulue.
export component Icon inherits Image {
    in property <string> name;
    in property <color> tint: Theme.text;
    width: 18px;
    height: 18px;
    colorize: root.tint;
    image-fit: contain;
    source: root.name == "move" ? @image-url("icons/move.svg")
        : root.name == "rotate" ? @image-url("icons/rotate.svg")
        : root.name == "magnet" ? @image-url("icons/magnet.svg")
        : root.name == "cube" ? @image-url("icons/cube.svg")
        : root.name == "view-front" ? @image-url("icons/view-front.svg")
        : root.name == "view-top" ? @image-url("icons/view-top.svg")
        : root.name == "view-side" ? @image-url("icons/view-side.svg")
        : root.name == "camera" ? @image-url("icons/camera.svg")
        : root.name == "focus" ? @image-url("icons/focus.svg")
        : root.name == "eye" ? @image-url("icons/eye.svg")
        : root.name == "layers" ? @image-url("icons/layers.svg")
        : root.name == "remote" ? @image-url("icons/remote.svg")
        : root.name == "haze" ? @image-url("icons/haze.svg")
        : root.name == "exposure" ? @image-url("icons/exposure.svg")
        : root.name == "ambient" ? @image-url("icons/ambient.svg")
        : root.name == "fullscreen" ? @image-url("icons/fullscreen.svg")
        : root.name == "plan" ? @image-url("icons/plan.svg")
        : root.name == "grid" ? @image-url("icons/grid.svg")
        : root.name == "chevron-left" ? @image-url("icons/chevron-left.svg")
        : root.name == "chevron-right" ? @image-url("icons/chevron-right.svg")
        : root.name == "chevron-up" ? @image-url("icons/chevron-up.svg")
        : root.name == "chevron-down" ? @image-url("icons/chevron-down.svg")
        : root.name == "select" ? @image-url("icons/select.svg")
        : root.name == "rect" ? @image-url("icons/rect.svg")
        : root.name == "ellipse" ? @image-url("icons/ellipse.svg")
        : root.name == "polygon" ? @image-url("icons/polygon.svg")
        : root.name == "freehand" ? @image-url("icons/freehand.svg")
        : root.name == "line" ? @image-url("icons/line.svg")
        : root.name == "arrow" ? @image-url("icons/arrow.svg")
        : root.name == "text" ? @image-url("icons/text.svg")
        : root.name == "measure" ? @image-url("icons/measure.svg")
        : root.name == "fit" ? @image-url("icons/fit.svg")
        : root.name == "image" ? @image-url("icons/image.svg")
        : root.name == "download" ? @image-url("icons/download.svg")
        : root.name == "plus" ? @image-url("icons/plus.svg")
        : root.name == "folder" ? @image-url("icons/folder.svg")
        : root.name == "folder-open" ? @image-url("icons/folder-open.svg")
        : root.name == "sort" ? @image-url("icons/sort.svg")
        : root.name == "search" ? @image-url("icons/search.svg")
        : root.name == "dots" ? @image-url("icons/dots.svg")
        : root.name == "close" ? @image-url("icons/close.svg")
        : root.name == "photo" ? @image-url("icons/photo.svg")
        : root.name == "mic" ? @image-url("icons/mic.svg")
        // dessinées pour l'inspecteur (la version JavaScript y met les caractères ⧉ et 🗑)
        : root.name == "copy" ? @image-url("icons/copy.svg")
        : root.name == "trash" ? @image-url("icons/trash.svg")
        : root.name == "power" ? @image-url("icons/power.svg")
        : @image-url("icons/sparkle.svg");
}

/// Bouton des barres d'outils (`.ib` de la version JavaScript) : icône, texte facultatif, état actif.
export component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    // actif en orange (aimant) plutôt qu'en bleu
    in property <bool> warm;
    // flèche : ouvre un menu
    in property <bool> dropdown;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    out property <length> natural-width: max(32px, row.preferred-width);
    property <bool> hovering: touch.has-hover;
    changed hovering => {
        if (self.hovering && root.tip != "") {
            Tip.text = root.tip;
            Tip.x = self.absolute-position.x;
            Tip.y = self.absolute-position.y + self.height + 4px;
            Tip.visible = true;
        } else if (Tip.text == root.tip) {
            Tip.visible = false;
        }
    }
    height: 30px;
    min-width: root.natural-width;
    max-width: root.natural-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: root.active && root.warm ? #ffad3b29 : root.active ? Theme.active : touch.has-hover && root.enabled ? Theme.hover : Theme.panel-2;
    border-width: 1px;
    border-color: root.active && root.warm ? Theme.accent : root.active ? Theme.active-line : touch.has-hover && root.enabled ? #48505e : Theme.line-2;
    opacity: root.enabled ? 1 : 0.45;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 7px;
        padding-right: 7px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                tint: root.active && root.warm ? Theme.accent : root.active ? #ffffff : Theme.text;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.active && root.warm ? Theme.accent : root.active ? #ffffff : Theme.text;
            font-size: Theme.font;
            vertical-alignment: center;
        }
        if root.dropdown: VerticalLayout {
            alignment: center;
            Icon {
                width: 12px;
                height: 12px;
                name: "chevron-down";
                tint: Theme.muted;
            }
        }
    }
}

/// Bouton texte (boutons ordinaires de la version JavaScript ; `primary` : orange).
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    min-width: label.preferred-width + 22px;
    border-radius: Theme.radius;
    background: root.primary ? Theme.accent : touch.has-hover && root.enabled ? Theme.hover : Theme.panel-2;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : touch.has-hover && root.enabled ? #48505e : Theme.line-2;
    opacity: root.enabled ? 1 : 0.45;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        text: root.text;
        color: root.primary ? Theme.accent-ink : Theme.text;
        font-weight: root.primary ? 600 : 400;
        font-size: Theme.font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Séparateur vertical des barres d'outils.
export component ToolSep inherits Rectangle {
    width: 9px;
    height: 20px;
    Rectangle {
        width: 1px;
        height: parent.height;
        background: Theme.line-2;
    }
}

/// Pastille d'état (Art-Net, sACN…) : un point vert quand c'est actif.
export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> warn;
    // état détaillé (comme `.pill.ok / .idle / .err`) : 0 selon `on`, 1 à l'écoute, 2 données reçues,
    // 3 erreur ; bulle d'aide ; cliquable
    in property <int> state;
    in property <string> tip;
    in property <bool> clickable;
    callback clicked();
    property <int> shown: root.state > 0 ? root.state : root.on ? 2 : 0;
    height: 22px;
    min-width: pill-row.preferred-width + 18px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.shown == 3 ? #ff6b6b80 : Theme.line-2;
    background: root.clickable && touch.has-hover ? Theme.panel-2 : transparent;
    touch := TouchArea {
        mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.clickable) {
                root.clicked();
            }
        }
        changed has-hover => {
            if (self.has-hover && root.tip != "") {
                Tip.text = root.tip;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + self.height + 4px;
                Tip.visible = true;
            } else if (!self.has-hover) {
                Tip.visible = false;
            }
        }
    }
    pill-row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.shown == 2 ? Theme.ok : root.shown == 1 ? #2f8f5b : root.shown == 3 ? Theme.err : root.warn ? Theme.warn : Theme.dim;
                drop-shadow-blur: root.shown == 2 ? 6px : 0;
                drop-shadow-color: Theme.ok;
            }
        }
        Text {
            text: root.text;
            color: root.shown == 2 ? Theme.text : Theme.muted;
            font-size: Theme.small;
            vertical-alignment: center;
        }
    }
}

/// Titre de panneau (« BIBLIOTHÈQUE », « SCÈNE 24 ») : petites capitales espacées.
export component PanelTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> count;
    spacing: 6px;
    Text {
        text: root.text;
        color: Theme.muted;
        font-size: Theme.tiny;
        font-weight: 700;
        letter-spacing: 0.9px;
        vertical-alignment: center;
    }
    if root.count != "": Text {
        text: root.count;
        color: Theme.dim;
        font-size: Theme.tiny;
        vertical-alignment: center;
    }
    Rectangle { }
}

/// Onglet (tiroir du bas, bibliothèque) : souligné orange quand il est choisi.
export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <string> icon;
    callback clicked();
    height: 30px;
    min-width: tab-row.preferred-width + 24px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    background: root.active ? Theme.panel-2 : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    if root.active: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.accent;
    }
    tab-row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                width: 15px;
                height: 15px;
                name: root.icon;
                tint: root.active ? Theme.text : Theme.muted;
            }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.text : touch.has-hover ? Theme.text : Theme.muted;
            font-size: Theme.font;
            vertical-alignment: center;
        }
    }
}

/// Curseur de la barre d'outils (brume, exposition, ambiance) : icône, curseur fin, valeur.
export component ToolSlider inherits Rectangle {
    in property <string> icon;
    in property <string> value-text;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <string> tip;
    callback moved(float);
    property <bool> hovering: slider-hover.has-hover;
    changed hovering => {
        if (self.hovering && root.tip != "") {
            Tip.text = root.tip;
            Tip.x = self.absolute-position.x;
            Tip.y = self.absolute-position.y + self.height + 4px;
            Tip.visible = true;
        } else if (Tip.text == root.tip) {
            Tip.visible = false;
        }
    }
    height: 30px;
    min-width: slider-row.preferred-width + 16px;
    max-width: slider-row.preferred-width + 16px;
    horizontal-stretch: 0;
    slider-hover := TouchArea { }
    border-radius: Theme.radius;
    background: Theme.panel-2;
    border-width: 1px;
    border-color: Theme.line-2;
    slider-row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                tint: Theme.muted;
            }
        }
        // piste et curseur dessinés : fins, comme les curseurs de la version JavaScript
        track := Rectangle {
            width: 64px;
            property <float> k: (root.value - root.minimum) / max(0.000001, root.maximum - root.minimum);
            Rectangle {
                y: (parent.height - 4px) / 2;
                height: 4px;
                border-radius: 2px;
                background: Theme.line-2;
            }
            Rectangle {
                y: (parent.height - 4px) / 2;
                width: parent.width * clamp(track.k, 0, 1);
                height: 4px;
                border-radius: 2px;
                background: Theme.accent;
            }
            Rectangle {
                x: parent.width * clamp(track.k, 0, 1) - 6px;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: Theme.text;
            }
            TouchArea {
                function set(x: length) {
                    let k = clamp(x / track.width, 0, 1);
                    let v = root.minimum + round(k * (root.maximum - root.minimum) / root.step) * root.step;
                    root.value = v;
                    root.moved(v);
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.set(self.mouse-x);
                    }
                }
                moved => {
                    if (self.pressed) {
                        self.set(self.mouse-x);
                    }
                }
            }
        }
        if root.value-text != "": Text {
            min-width: 38px;
            text: root.value-text;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: Theme.small;
            vertical-alignment: center;
        }
    }
}

/// Icône d'un type de la bibliothèque (ui/icons/lib, node tools/rust/export-lib-icons.mjs).
export component LibIcon inherits Image {
    in property <string> name;
    width: 26px;
    height: 18px;
    image-fit: contain;
    source: root.name == "fixture-bulb" ? @image-url("icons/lib/fixture-bulb.svg")
        : root.name == "fixture-fresnel" ? @image-url("icons/lib/fixture-fresnel.svg")
        : root.name == "fixture-multi" ? @image-url("icons/lib/fixture-multi.svg")
        : root.name == "fixture-open-face" ? @image-url("icons/lib/fixture-open-face.svg")
        : root.name == "fixture-panel" ? @image-url("icons/lib/fixture-panel.svg")
        : root.name == "fixture-par" ? @image-url("icons/lib/fixture-par.svg")
        : root.name == "fixture-spot" ? @image-url("icons/lib/fixture-spot.svg")
        : root.name == "fixture-tube" ? @image-url("icons/lib/fixture-tube.svg")
        : root.name == "grip-bag" ? @image-url("icons/lib/grip-bag.svg")
        : root.name == "grip-bounce" ? @image-url("icons/lib/grip-bounce.svg")
        : root.name == "grip-box" ? @image-url("icons/lib/grip-box.svg")
        : root.name == "grip-flag" ? @image-url("icons/lib/grip-flag.svg")
        : root.name == "grip-frame" ? @image-url("icons/lib/grip-frame.svg")
        : root.name == "grip-stand" ? @image-url("icons/lib/grip-stand.svg")
        : root.name == "prop-animals" ? @image-url("icons/lib/prop-animals.svg")
        : root.name == "prop-filmset" ? @image-url("icons/lib/prop-filmset.svg")
        : root.name == "prop-furniture" ? @image-url("icons/lib/prop-furniture.svg")
        : root.name == "prop-outdoor" ? @image-url("icons/lib/prop-outdoor.svg")
        : root.name == "prop-people" ? @image-url("icons/lib/prop-people.svg")
        : root.name == "prop-props" ? @image-url("icons/lib/prop-props.svg")
        : root.name == "prop-set" ? @image-url("icons/lib/prop-set.svg")
        : @image-url("icons/lib/prop-vehicles.svg");
}

/// Champ de saisie simple (nombres, coordonnées) au style de la version JavaScript ; validé par Entrée
/// ou en quittant le champ.
export component FieldEdit inherits Rectangle {
    // texte donné par l'appelant ; pendant la saisie, celui du champ
    in property <string> text;
    in property <bool> mono;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);
    property <bool> focused: edit.has-focus;
    changed text => {
        if (!edit.has-focus) {
            edit.text = root.text;
        }
    }
    changed focused => {
        if (!self.focused) {
            if (edit.text != root.text) {
                root.accepted(edit.text);
            }
            edit.text = root.text;
        }
    }
    min-width: 36px;
    height: 26px;
    border-radius: 4px;
    background: Theme.field;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.active-line : Theme.line-2;
    opacity: root.enabled ? 1 : 0.5;
    clip: true;
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            edit.focus();
        }
    }
    edit := TextInput {
        property <length> computed-x;
        x: 6px + min(0px, max(parent.width - 12px - self.width - self.text-cursor-width, self.computed-x));
        width: max(parent.width - 12px - self.text-cursor-width, self.preferred-width);
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-family: root.mono ? Theme.mono : "Segoe UI";
        font-size: root.mono ? Theme.small : Theme.font;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled;
        selection-background-color: #2d6cdf99;
        selection-foreground-color: Theme.text;
        cursor-position-changed(cpos) => {
            if (cpos.x + self.computed-x < 0px) {
                self.computed-x = -cpos.x;
            } else if (cpos.x + self.computed-x > parent.width - 12px - self.text-cursor-width) {
                self.computed-x = parent.width - 12px - cpos.x - self.text-cursor-width;
            }
        }
        accepted => {
            root.accepted(self.text);
        }
        edited => {
            root.edited(self.text);
        }
    }
}

/// Bord d'un panneau à tirer pour le redimensionner (trait de 1 px, zone de prise de 5 px).
export component Splitter inherits Rectangle {
    // vertical : bord gauche ou droit (on tire en x) ; sinon bord du haut (on tire en y)
    in property <bool> vertical: true;
    // déplacement depuis l'appui (le bord suit : chaque appel donne le reste à appliquer)
    callback dragged(length);
    callback released();
    // (épaisseur donnée par l'appelant : width 5px ou height 5px ; l'autre sens suit la mise en page)
    Rectangle {
        x: root.vertical ? 2px : 0;
        y: root.vertical ? 0 : 2px;
        width: root.vertical ? 1px : parent.width;
        height: root.vertical ? parent.height : 1px;
        background: touch.pressed || touch.has-hover ? Theme.accent : Theme.line;
    }
    touch := TouchArea {
        mouse-cursor: root.vertical ? MouseCursor.col-resize : MouseCursor.row-resize;
        moved => {
            if (self.pressed) {
                root.dragged(root.vertical ? self.mouse-x - self.pressed-x : self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.released();
            }
        }
    }
}

/// Curseur fin (piste, part orange, bouton blanc), comme `input[type=range]` de la version JavaScript.
export component ThinSlider inherits Rectangle {
    // valeur donnée par l'appelant ; pendant un geste, celle du geste
    in property <float> value;
    property <bool> dragging;
    property <float> drag-value;
    in property <float> minimum;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <bool> enabled: true;
    callback changed(float);
    height: 20px;
    min-width: 60px;
    opacity: root.enabled ? 1 : 0.45;
    property <float> shown: root.dragging ? root.drag-value : root.value;
    property <float> k: clamp((root.shown - root.minimum) / max(0.000001, root.maximum - root.minimum), 0, 1);
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.line-2;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: (parent.width - 12px) * root.k + 6px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: (parent.width - 12px) * root.k;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: slider-touch.pressed || slider-touch.has-hover ? #ffffff : Theme.text;
    }
    slider-touch := TouchArea {
        enabled: root.enabled;
        function set(x: length) {
            let k = clamp((x - 6px) / max(1px, root.width - 12px), 0, 1);
            let v = root.minimum + round(k * (root.maximum - root.minimum) / root.step) * root.step;
            if (v != root.shown) {
                root.drag-value = v;
                root.changed(v);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag-value = root.value;
                root.dragging = true;
                self.set(self.mouse-x);
            }
            if (e.kind == PointerEventKind.up) {
                root.dragging = false;
            }
        }
        moved => {
            if (self.pressed) {
                self.set(self.mouse-x);
            }
        }
        scroll-event(e) => {
            let d = e.delta-y > 0 ? root.step : -root.step;
            let v = clamp(root.value + d, root.minimum, root.maximum);
            if (v != root.value) {
                root.changed(v);
            }
            accept
        }
    }
}

/// Liste déroulante (comme `select`) : le choix actuel et une flèche ; le menu des choix s'ouvre dessous.
export component Choice inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index;
    in property <bool> enabled: true;
    callback selected(int);
    min-width: 60px;
    height: 26px;
    border-radius: 4px;
    background: choice-touch.has-hover && root.enabled ? #14181d : Theme.field;
    border-width: 1px;
    border-color: choice-touch.has-hover && root.enabled ? #48505e : Theme.line-2;
    opacity: root.enabled ? 1 : 0.5;
    choice-menu := ContextMenuArea {
        enabled: false;
        Menu {
            for m[i] in root.model: MenuItem {
                title: m;
                checkable: true;
                checked: i == root.current-index;
                activated => {
                    root.selected(i);
                }
            }
        }
    }
    choice-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            choice-menu.show({ x: 0, y: root.height + 2px });
        }
    }
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "—";
            color: Theme.text;
            font-size: Theme.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                width: 12px;
                height: 12px;
                name: "chevron-down";
                tint: Theme.muted;
            }
        }
    }
}

/// Case à cocher orange (comme `input[type=checkbox]` avec `accent-color`), texte facultatif.
export component Check inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 22px;
    min-width: check-row.preferred-width;
    opacity: root.enabled ? 1 : 0.45;
    check-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled(!root.checked);
        }
    }
    check-row := HorizontalLayout {
        spacing: 7px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                background: root.checked ? Theme.accent : Theme.field;
                border-width: 1px;
                border-color: root.checked ? Theme.accent : check-touch.has-hover ? #6a7380 : Theme.line-2;
                if root.checked: Path {
                    width: 12px;
                    height: 12px;
                    x: 2px;
                    y: 2px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M2.5 6.5 L5 9 L9.5 3.5";
                    stroke: Theme.accent-ink;
                    stroke-width: 2px;
                    fill: transparent;
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font;
            vertical-alignment: center;
        }
    }
}

/// Fader vertical de la console (comme `.fader input[type=range]` de la version JavaScript) :
/// piste fine, part orange depuis le bas, bouton ; molette : un pas de 1/255.
export component Fader inherits Rectangle {
    // valeur donnée par l'appelant ; pendant un geste, celle du geste
    in property <float> value;
    property <bool> dragging;
    property <float> drag-value;
    in property <float> maximum: 255;
    callback changed(float);
    min-height: 28px;
    min-width: 22px;
    property <float> k: clamp((root.dragging ? root.drag-value : root.value) / max(1, root.maximum), 0, 1);
    property <length> pad: 6px;
    Rectangle {
        x: (parent.width - 4px) / 2;
        y: root.pad;
        width: 4px;
        height: parent.height - 2 * root.pad;
        border-radius: 2px;
        background: Theme.line-2;
    }
    Rectangle {
        x: (parent.width - 4px) / 2;
        y: root.pad + (parent.height - 2 * root.pad) * (1 - root.k);
        width: 4px;
        height: (parent.height - 2 * root.pad) * root.k;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: (parent.width - 16px) / 2;
        y: root.pad + (parent.height - 2 * root.pad) * (1 - root.k) - 5px;
        width: 16px;
        height: 10px;
        border-radius: 3px;
        background: fader-touch.pressed || fader-touch.has-hover ? #ffffff : Theme.text;
        border-width: 1px;
        border-color: #00000060;
    }
    fader-touch := TouchArea {
        function set(y: length) {
            let k = clamp(1 - (y - root.pad) / max(1px, root.height - 2 * root.pad), 0, 1);
            let v = round(k * root.maximum);
            if (v != root.drag-value) {
                root.drag-value = v;
                root.changed(v);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag-value = root.value;
                root.dragging = true;
                self.set(self.mouse-y);
            }
            if (e.kind == PointerEventKind.up) {
                root.dragging = false;
            }
        }
        moved => {
            if (self.pressed) {
                self.set(self.mouse-y);
            }
        }
        scroll-event(e) => {
            let step = max(1, round(root.maximum / 255));
            let v = clamp(root.value + (e.delta-y > 0 ? step : -step), 0, root.maximum);
            if (v != root.value) {
                root.changed(v);
            }
            accept
        }
    }
}

/// Poignée de repli d'un panneau (`.panel-handle`), au milieu de son bord : flèche, orange au survol.
export component FoldHandle inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    callback clicked();
    background: fold-touch.has-hover ? #20252c : Theme.panel-2;
    border-width: 1px;
    border-color: fold-touch.has-hover ? Theme.accent : Theme.line-2;
    property <bool> hovering: fold-touch.has-hover;
    changed hovering => {
        if (self.hovering && root.tip != "") {
            Tip.text = root.tip;
            Tip.x = self.absolute-position.x;
            Tip.y = self.absolute-position.y + self.height + 4px;
            Tip.visible = true;
        } else if (Tip.text == root.tip) {
            Tip.visible = false;
        }
    }
    fold-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Tip.visible = false;
            root.clicked();
        }
    }
    Icon {
        width: 20px;
        height: 20px;
        name: root.icon;
        tint: fold-touch.has-hover ? Theme.accent : Theme.muted;
    }
}

/// Panneau latéral replié (`.panel-strip`) : bande étroite au nom écrit verticalement ; un clic le déplie.
export component FoldStrip inherits Rectangle {
    in property <string> text;
    callback clicked();
    background: strip-touch.has-hover ? #1a1e24 : Theme.panel;
    strip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    // une lettre sous l'autre, en capitales espacées
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        for c in root.letters: Text {
            text: c;
            color: strip-touch.has-hover ? Theme.accent : Theme.muted;
            font-size: Theme.tiny;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
    in property <[string]> letters;
}
